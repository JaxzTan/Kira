# ─── Server ───────────────────────────────────────────────
PORT=8080
# Where the browser reaches the app. Dev (Vite proxy): http://localhost:5173
# Prod on this machine: http://localhost:8080   ·  Tailscale: https://<machine>.<tailnet>.ts.net
PUBLIC_URL=http://localhost:5173
DATA_DIR=./data

# ─── Google OAuth (Gate A — fill from Google Cloud Console) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The ONLY Google account allowed in
ALLOWED_EMAIL=
# Optional. Google user ID; auto-pinned in the DB on first successful login
ALLOWED_SUB=

# ─── Secrets (generated by scripts/bootstrap.sh) ──────────
SESSION_SECRET=
# Signs the ledger hash chain. BACK THIS UP in your password manager.
LEDGER_KEY=

# ─── Backup (Gate B, optional) ────────────────────────────
# Empty = Litestream replicates to ./backup on local disk instead
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_ENDPOINT=
# Optional age PUBLIC key (age1...) to encrypt replicas. Keep the matching identity (AGE-SECRET-KEY-...)
# OFFLINE in your password manager: restore needs it. Empty = replicas are unencrypted.
LITESTREAM_AGE_RECIPIENT=
# Optional. rsync target for data/receipts (e.g. user@nas:/backups/kira-receipts). Empty = ./backup/receipts
RECEIPTS_SYNC_TARGET=
# Optional. Listen address host (default 127.0.0.1). Keep loopback; use `tailscale serve` for remote access.
# A non-loopback HOST is refused unless PUBLIC_URL is https.
HOST=
# Optional. Set to 1 only behind exactly one trusted reverse proxy (e.g. `tailscale serve`) so the
# /auth rate limiter uses X-Forwarded-For. Leave empty for plain localhost.
TRUST_PROXY=
