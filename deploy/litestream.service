# systemd USER unit. Install:
#   sed "s|@REPO@|$PWD|g" deploy/litestream.service > ~/.config/systemd/user/litestream.service
#   systemctl --user daemon-reload && systemctl --user enable --now litestream
[Unit]
Description=Litestream replication for Kira
After=kira.service

[Service]
Type=simple
WorkingDirectory=@REPO@
# No EnvironmentFile: the wrapper reads only DATA_DIR and LITESTREAM_* from .env (least privilege).
ExecStart=/bin/bash @REPO@/scripts/run-litestream.sh
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
